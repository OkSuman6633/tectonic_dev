# Google Gemini API Key
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Model configuration
#GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Where generated agent projects are written (default: ./generated_agents)
AGENT_BUILDER_OUTPUT_DIR=./generated_agents
# Where trace logs are written (default: ./logs)
AGENT_BUILDER_LOG_DIR=./logs
# DEBUG | INFO | WARNING
AGENT_BUILDER_TRACE_LEVEL=INFO
# Set to 1 to also print OpenTelemetry spans to the console
AGENT_BUILDER_OTEL_CONSOLE=0
# Optional: use Tavily instead of DuckDuckGo for web_search
TAVILY_API_KEY=

# Multi-user sign-in (server_full.py)
# TECTONIC_AUTH_SECRET=<random hex: keeps users signed in across restarts>
# TECTONIC_ADMINS=alice,bob   # may change the Builder model/keys (default: the first account)
# TECTONIC_DATA_DIR=./data    # where accounts are stored

# Image generation (core_generate_image). Photos: Google (GOOGLE_API_KEY, or TECTONIC_IMAGE_API_KEY).
# Vector drawings (logos, icons, diagrams): Claude writes SVG with ANTHROPIC_API_KEY.
# TECTONIC_SVG_MODEL=claude-opus-5-5
# Models: gemini-2.5-flash-image (default; generates and edits) or imagen-4.0-generate-001 (prompt only).
# TECTONIC_IMAGE_MODEL=gemini-2.5-flash-image
# TECTONIC_IMAGE_API_KEY=
# TECTONIC_MEDIA_PATH=./generated_agents/_platform/media
