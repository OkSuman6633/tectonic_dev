# Social Media Content Ideation Agent - environment template
# Google Gemini API key (reasoning + Google image generation).
# Inside the Tectonic server the platform key is used; standalone, add your own.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Apify API token (Instagram / YouTube / Facebook scrapers).
# Apify Console -> Settings -> Integrations -> Personal API token.
APIFY_TOKEN=

# Optional tuning
# TECTONIC_IMAGE_MODEL=gemini-2.5-flash-image
# APIFY_WAIT_SECONDS=300
# APIFY_MAX_POSTS_PER_RUN=60
# APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
# APIFY_YOUTUBE_ACTOR=streamers~youtube-scraper
# APIFY_FACEBOOK_ACTOR=apify~facebook-posts-scraper
# TAVILY_API_KEY=
# SMCIA_SPEND_LIMIT_USD=15
